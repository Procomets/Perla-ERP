rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth & roles
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'Admin' || getUserRole() == 'admin');
    }

    function isManager() {
      return isAuthenticated() && (getUserRole() == 'Manager' || getUserRole() == 'manager');
    }

    function isSupervisor() {
      return isAuthenticated() && (getUserRole() == 'Supervisor' || getUserRole() == 'supervisor');
    }

    function isAuthorizedUser() {
      return isAdmin() || isManager();
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Vendors Collection
    match /vendors/{vendorId} {
      allow read, write: if isAuthenticated();

      // Contacts Subcollection
      match /contacts/{contactId} {
        allow read, write: if isAuthenticated();
      }

      // Documents Subcollection
      match /documents/{documentId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Vendor Audit Logs
    match /vendor_audit_logs/{auditId} {
      allow read, write: if isAuthenticated();
    }

    // Vendor Counters
    match /vendor_counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Purchase Orders Collection
    match /purchase_orders/{poId} {
      allow read, write: if isAuthenticated();
    }

    // Purchase Order Counters
    match /purchase_order_counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // PO Counters (po_counters)
    match /po_counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Purchase Order Audit Logs
    match /purchase_order_audit_logs/{auditId} {
      allow read, write: if isAuthenticated();
    }

    // Purchase Order Amendments
    match /purchase_order_amendments/{amendmentId} {
      allow read, write: if isAuthenticated();
    }

    // Inward Entries Collection
    match /inward_entries/{inwardId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin(); // Admin only delete permission

      // Subcollection: lines
      match /lines/{lineId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthorizedUser();
        allow delete: if isAdmin();
      }
    }

    // Inward Counters
    match /inward_counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthorizedUser();
    }

    // Inward Audit Logs
    match /inward_audit_logs/{auditId} {
      allow read: if isAuthenticated();
      allow create: if isAuthorizedUser();
      allow update, delete: if false; // Immutable audit log
    }

    // Outward Entries Collection
    match /outward_entries/{outwardId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin(); // Admin only delete permission for drafts

      // Subcollection: lines
      match /lines/{lineId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthorizedUser();
        allow delete: if isAdmin();
      }
    }

    // Outward Counters
    match /outward_counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthorizedUser();
    }

    // Outward Audit Logs (Immutable)
    match /outward_audit_logs/{auditId} {
      allow read: if isAuthenticated();
      allow create: if isAuthorizedUser();
      allow update, delete: if false; // Immutable audit log
    }

    // Employee Master Collection
    match /employeeMaster/{empId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read, write: if isAuthenticated();
    }

    // General Settings Collection
    match /generalSettings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    // Salary Sheets Collection
    match /salarySheets/{salarySheetId} {
      allow read, write: if isAuthenticated();
    }

    // Invoice Approvals (Statement Reconciliation & Invoice Module)
    match /invoice_approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin();
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthorizedUser();
      allow update: if isAuthorizedUser();
      allow delete: if isAdmin();

      // Subcollection: lines
      match /lines/{lineId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthorizedUser();
        allow delete: if isAdmin();
      }
    }

    // Invoice Number Counters
    match /invoice_counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthorizedUser();
    }

    // Invoice Audit Logs (Immutable)
    match /invoice_audit_logs/{auditId} {
      allow read: if isAuthenticated();
      allow create: if isAuthorizedUser();
      allow update, delete: if false; // Immutable audit log
    }

    // Company Invoice Settings
    match /invoice_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default allow authenticated users
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
