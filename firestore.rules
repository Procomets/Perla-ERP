rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth & roles
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'Admin' || getUserRole() == 'admin');
    }

    function isManager() {
      return isAuthenticated() && (getUserRole() == 'Manager' || getUserRole() == 'manager');
    }

    function isSupervisor() {
      return isAuthenticated() && (getUserRole() == 'Supervisor' || getUserRole() == 'supervisor');
    }

    function isAuthorizedUser() {
      return isAdmin() || isManager();
    }

    // Vendors Collection
    match /vendors/{vendorId} {
      // Allow read to Admin, Manager, and Supervisor (with read approval)
      allow read: if isAuthenticated();

      // Creation & Updates: Only Admin and Manager via authorized Cloud Functions or direct matching write rules
      allow create: if isAuthorizedUser()
                    && request.resource.data.vendorCode != null
                    && !request.resource.data.keys().hasAny(['financialDetails']) || isAuthorizedUser();

      allow update: if isAuthorizedUser()
                    && request.resource.data.vendorCode == resource.data.vendorCode
                    && request.resource.data.createdAt == resource.data.createdAt;

      // Prevent hard deletion of vendors (soft deactivation required)
      allow delete: if isAdmin();

      // Contacts Subcollection
      match /contacts/{contactId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthorizedUser();
        allow delete: if isAdmin();
      }

      // Documents Subcollection
      match /documents/{documentId} {
        allow read: if isAuthorizedUser();
        allow create, update: if isAuthorizedUser();
        allow delete: if isAdmin();
      }
    }

    // Vendor Audit Logs (Immutable, Client Write Prohibited)
    match /vendor_audit_logs/{auditId} {
      allow read: if isAuthorizedUser();
      allow write: if false; // Only Cloud Functions / Admin SDK can write audit logs
    }

    // Vendor Counters (Client Write Prohibited)
    match /vendor_counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if false; // Atomic updates strictly handled by server Cloud Functions
    }

    // Purchase Orders Collection
    match /purchase_orders/{poId} {
      allow read: if isAuthenticated();

      // Only Admin and Manager can create and update purchase orders
      allow create: if isAuthorizedUser()
                    && request.resource.data.poNumber != null
                    && request.resource.data.customerId != null;

      allow update: if isAuthorizedUser()
                    && request.resource.data.poNumber == resource.data.poNumber
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin() && resource.data.status == 'draft';
    }

    // Purchase Order Counters (Server-only write)
    match /purchase_order_counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if false; // Atomic updates strictly handled by server Cloud Functions
    }

    // Purchase Order Audit Logs (Immutable, Server-only write)
    match /purchase_order_audit_logs/{auditId} {
      allow read: if isAuthorizedUser();
      allow write: if false; // Only Cloud Functions / Admin SDK can write audit logs
    }

    // Purchase Order Amendments
    match /purchase_order_amendments/{amendmentId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin();
    }

    // Employee Master Collection
    match /employeeMaster/{empId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read, write: if isAuthenticated();
    }

    // General Settings Collection
    match /generalSettings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    // Salary Sheets Collection
    match /salarySheets/{salarySheetId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny all other collections unless explicitly matched
    match /{document=**} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
  }
}
